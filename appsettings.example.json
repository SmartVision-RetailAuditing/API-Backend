{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=smartvision_db;Username=postgres;Password=YOUR_PASSWORD"
  },
  "JwtSettings": {
    "Key": "GENERATE_WITH: python3 -c \"import secrets; print(secrets.token_hex(48))\"",
    "Issuer": "SmartVisionAPI",
    "Audience": "SmartVisionClient",
    "DurationInMinutes": 60
  },
  "AzureBlobStorage": {
    "ConnectionString": "GET_FROM_AZURE_PORTAL > Storage Accounts > smartvisionimages > Access Keys",
    "ContainerName": "premlmodelimages"
  },
  "AIVisionService": {
    "BaseUrl": "http://python-service-url",
    "ApiKey": ""
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173,https://YOUR_AZURE_FRONTEND_URL"
  }
}